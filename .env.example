# ---- Claude / Anthropic ----
# Required. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the companion. Default is Anthropic's recommended Opus-tier model.
FRIENDAGENT_MODEL=claude-opus-4-8

# ---- Persona (set the whole personality right here in env) ----
# The relationship the companion plays. Common values: lover, partner, friend,
# best_friend, sibling, brother, sister, pen_pal, grandchild. Any string works —
# it's woven into the prompt. This is the main knob you asked for.
FRIENDAGENT_RELATIONSHIP=friend
# The companion's name and basic identity.
FRIENDAGENT_PERSONA_NAME=Sam
FRIENDAGENT_PERSONA_AGE=68
FRIENDAGENT_PERSONA_GENDER=
# Free-text personality traits (comma-separated or a sentence).
FRIENDAGENT_PERSONA_TRAITS=warm, patient, gently funny, curious, a good listener
# Short backstory / who they are. Keep it believable and consistent.
FRIENDAGENT_PERSONA_BACKSTORY=A retired schoolteacher who loves gardening, old movies, and a good cup of tea.
# Interests they bring up and ask about.
FRIENDAGENT_PERSONA_INTERESTS=gardening, classic films, baking, crosswords, family stories
# How they talk: tone/style guidance.
FRIENDAGENT_PERSONA_TONE=affectionate but easygoing; short, clear messages; one question at a time
# The person they're talking to (your grandma) — helps personalization.
FRIENDAGENT_COMPANION_FOR_NAME=Grandma
FRIENDAGENT_COMPANION_FOR_NOTES=Lonely, lives alone, hard of hearing, loves talking about her late husband and her garden.
# How the family wants the companion to refer to itself when honesty comes up.
FRIENDAGENT_AI_DISCLOSURE=I'm an AI friend your family set up so you always have someone to chat with.
# Optional: a YAML file overrides/extends any of the above (see config/persona.example.yaml)
FRIENDAGENT_PERSONA_PATH=config/persona.yaml

# ---- Data ----
FRIENDAGENT_DB_PATH=friendagent.db

# ---- Proactive check-ins ----
# Times (24h, comma-separated) the agent reaches out on its own each day.
FRIENDAGENT_CHECKIN_TIMES=09:30,18:00
FRIENDAGENT_TIMEZONE=America/New_York
# Who the agent proactively reaches out to. Use channel-prefixed addresses so
# each contact is reached over the right channel. Comma-separated.
#   whatsapp:+1...   sms:+1...   email:grandma@example.com
# (Anyone who has already messaged the agent is included automatically.)
FRIENDAGENT_SEED_CONTACTS=

# ---- Who to alert when a scam red flag appears ----
# This is YOU (the family member). At least one channel should be set.
FRIENDAGENT_ALERT_EMAIL=connordenicola@gmail.com
# Optional SMS alert to the family member (uses the Twilio creds below)
FRIENDAGENT_ALERT_SMS_TO=

# Use Claude to double-check borderline messages for scam intent (costs a little
# extra per flagged message). "true" or "false".
FRIENDAGENT_LLM_SAFETY_CHECK=true

# ---- SMTP (for emailing alerts to the family member) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Twilio (WhatsApp + optional SMS alerts) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox number)
TWILIO_WHATSAPP_FROM=
# Plain SMS sender, e.g. +14155551234 — used both to text her and to text alerts.
TWILIO_SMS_FROM=
# Verify incoming Twilio webhook signatures ("true" recommended in production)
TWILIO_VALIDATE_SIGNATURE=false
